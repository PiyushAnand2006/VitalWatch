# Copy to .env and replace the secret before starting the application.
APP_ENV=development
APP_NAME=VitalWatch Part 2
APP_VERSION=0.1.0
APP_SECRET_KEY=replace_with_secure_random_secret_at_least_32_chars
DEBUG=false
API_DOCS_ENABLED=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vitalwatch
DOCUMENT_STORAGE_DIRECTORY=./data/documents
UPLOAD_MAX_MB=20
UPLOAD_MAX_PAGES=200
OCR_LANGUAGE=eng
# TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional 32-byte urlsafe key for local document encryption at rest
# DOCUMENT_STORAGE_ENCRYPTION_KEY=

# Local embeddings only (sentence-transformers/all-MiniLM-L6-v2, 384 dimensions).
# The model directory is a cache folder; no remote embedding API is ever called.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=main
EMBEDDING_MODEL_DIRECTORY=./data/models
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# After the first download, set true to forbid any further model download attempt.
EMBEDDING_LOCAL_FILES_ONLY=false

# Mandatory privacy boundary; false is rejected at configuration load.
PRIVACY_GATE_ENABLED=true
# External model calls remain off until later stages are implemented and configured.
EXTERNAL_LLM_ENABLED=false

# Retrieval policy (local query embeddings plus pgvector cosine search).
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MAX_QUERY_CHARS=2000
