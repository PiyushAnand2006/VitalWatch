# Copy to .env and replace the secret before starting the application.
APP_ENV=development
APP_NAME=VitalWatch Part 2
APP_VERSION=0.1.0
APP_SECRET_KEY=replace_with_secure_random_secret_at_least_32_chars
DEBUG=false
API_DOCS_ENABLED=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vitalwatch
DOCUMENT_STORAGE_DIRECTORY=./data/documents
UPLOAD_MAX_MB=20
UPLOAD_MAX_PAGES=200
OCR_LANGUAGE=eng
# TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional 32-byte urlsafe key for local document encryption at rest
# DOCUMENT_STORAGE_ENCRYPTION_KEY=

# Local embeddings only (sentence-transformers/all-MiniLM-L6-v2, 384 dimensions).
# The model directory is a cache folder; no remote embedding API is ever called.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=main
EMBEDDING_MODEL_DIRECTORY=./data/models
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# After the first download, set true to forbid any further model download attempt.
EMBEDDING_LOCAL_FILES_ONLY=false

# Mandatory privacy boundary; false is rejected at configuration load.
PRIVACY_GATE_ENABLED=true
# Local-only mode blocks every external dispatch before Presidio analysis.
PRIVACY_LOCAL_ONLY=true
# Approved payloads are single-use and expire. Range: 30-3600 seconds.
PRIVACY_APPROVAL_TTL_SECONDS=300
PRIVACY_MAX_QUESTION_CHARS=2000
# Presidio loads this local spaCy model; install it with `python -m spacy download`.
PRIVACY_NLP_MODEL=en_core_web_sm
PRIVACY_ANALYZER_SCORE_THRESHOLD=0.5
# External calls require BOTH PRIVACY_LOCAL_ONLY=false and this flag true.
EXTERNAL_LLM_ENABLED=false

# Retrieval policy (local query embeddings plus pgvector cosine search).
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MAX_QUERY_CHARS=2000

# ---------------------------------------------------------------------------
# Stage 7: external model providers, slots, and routing.
# Every slot must be fully configured (provider + model) and each exact
# destination is privacy-approved per call. Secrets below are placeholders.
# ---------------------------------------------------------------------------
# Provider credentials and endpoints (documented defaults shown).
NVIDIA_API_KEY=
# NVIDIA_CHAT_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
GOOGLE_API_KEY=
# GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLAMA_API_KEY=
# LLAMA_BASE_URL is required for any llama slot.
LLAMA_BASE_URL=
# LLAMA_CHAT_ROUTE=/v1/chat/completions
# LLAMA_AUTH_HEADER=Authorization
# LLAMA_AUTH_SCHEME=Bearer

# Reasoner slots A/B/C and the separate final adjudicator slot.
# Provider values: nvidia | google | llama. Leave all unset to run local-only.
LLM_REASONER_A_PROVIDER=
LLM_REASONER_A_MODEL=
LLM_REASONER_B_PROVIDER=
LLM_REASONER_B_MODEL=
LLM_REASONER_C_PROVIDER=
LLM_REASONER_C_MODEL=
LLM_ADJUDICATOR_PROVIDER=
LLM_ADJUDICATOR_MODEL=
# Optional per-slot endpoint overrides (https required; http is loopback-only).
# LLM_REASONER_A_ENDPOINT=
# LLM_ADJUDICATOR_ENDPOINT=

# Optional fallback slot. Disabled by default; any fallback still requires a
# fresh, destination-specific privacy approval before it may transmit.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_ENABLED=false

# Request behavior: TLS-only remote endpoints, bounded retries, per-provider
# rate limits, and timeouts.
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RATE_LIMIT_PER_MINUTE=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2
