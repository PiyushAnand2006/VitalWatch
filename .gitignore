# security folder zcode
.mimosa/

# Agent and editor private state
.freebuff/
.codebuff/
.cursor/
.claude/
.idea/
.vscode/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Local databases and backups
*.db
*.sqlite
*.sqlite3
*.dump

# docs — tracked so reference material is available on the new system
# (not ignored — docs_pdf/, ppt/, architecture_png/ are all pushed)

# fine tuned model — track top-level source files; exclude agent/data subdirs inside
# finetune/ itself is NOT ignored so its .md/.py files are pushed
finetune/.mimosa/
finetune/data/
finetune/third_party/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python environments and caches — keep ignored (not needed on new system)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# Test and build artifacts — keep ignored (generated on the new system)
.coverage
htmlcov/
coverage.xml
build/
dist/
*.egg-info/

# Private runtime data and local model caches
data/
models/
.cache/
*.log
